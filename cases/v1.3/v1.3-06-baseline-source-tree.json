{
  "id": "v1.3-06-baseline-source-tree",
  "profile": "v1.3",
  "title": "Source-only base change hits setup, misses baseline and replaces red rows",
  "spec": [
    "\u00a72.9",
    "\u00a73.3"
  ],
  "fixture": "kt",
  "steps": [
    {
      "intent": {
        "slug": "greet",
        "push": true
      }
    },
    {
      "run": [
        "kogen",
        "intent",
        "approve",
        "greet"
      ],
      "expect": {
        "exit": 5,
        "stdout_contains": "baseline"
      }
    },
    {
      "origin_commit": {
        "files": {
          "lib/source.txt": "GREEN\n"
        },
        "pull": true
      }
    },
    {
      "run": [
        "kogen",
        "intent",
        "approve",
        "greet"
      ],
      "expect": {
        "exit": 5
      }
    },
    {
      "approve": "greet"
    },
    {
      "assert": {
        "files": {
          "{case}/checked.log": {
            "text": "RED\nGREEN\n"
          },
          "{case}/setup.log": {
            "text": "setup\n"
          }
        }
      }
    }
  ],
  "fixture_files": {
    "lockfile": "stable\n",
    "lib/source.txt": "RED\n",
    "checks/baseline.sh": "#!/bin/sh\nprintf \"%s\\n\" \"$(cat lib/source.txt)\" >> \"{case}/checked.log\"\ngrep -q GREEN lib/source.txt || { echo \"lib/source.txt:1:1: error: [test/base] source: defect\"; exit 1; }\n",
    "checks/setup.sh": "#!/bin/sh\necho setup >> \"{case}/setup.log\"\nmkdir -p build\necho product > build/product\n"
  },
  "project": {
    "setup_inputs": [
      "lockfile"
    ],
    "checks": [
      {
        "name": "baseline",
        "argv": [
          "sh",
          "checks/baseline.sh"
        ],
        "timeout_ms": 60000
      }
    ]
  }
}
