{
  "id": "v1.3-08-baseline-context",
  "profile": "v1.3",
  "title": "Changed effective check deadlines invalidate the baseline",
  "spec": [
    "\u00a72.9",
    "\u00a73.3"
  ],
  "fixture": "kt",
  "steps": [
    {
      "intent": {
        "slug": "greet",
        "push": true
      }
    },
    {
      "run": [
        "kogen",
        "intent",
        "approve",
        "greet"
      ],
      "expect": {
        "exit": 5
      }
    },
    {
      "sh": "sed 's/timeout_ms: 60000/timeout_ms: 59000/g' .kogen/project.yaml > project.new && mv project.new .kogen/project.yaml"
    },
    {
      "commit": {
        "message": "Changed effective deadline",
        "push": true
      }
    },
    {
      "run": [
        "kogen",
        "intent",
        "approve",
        "greet"
      ],
      "expect": {
        "exit": 5
      }
    },
    {
      "assert": {
        "files": {
          "{case}/checked.log": {
            "text": "GREEN\nGREEN\n"
          }
        }
      }
    }
  ],
  "fixture_files": {
    "lockfile": "stable\n",
    "lib/source.txt": "GREEN\n",
    "checks/baseline.sh": "#!/bin/sh\nprintf \"%s\\n\" \"$(cat lib/source.txt)\" >> \"{case}/checked.log\"\ngrep -q GREEN lib/source.txt || { echo \"lib/source.txt:1:1: error: [test/base] source: defect\"; exit 1; }\n",
    "checks/setup.sh": "#!/bin/sh\necho setup >> \"{case}/setup.log\"\nmkdir -p build\necho product > build/product\n"
  },
  "project": {
    "setup_inputs": [
      "lockfile"
    ],
    "checks": [
      {
        "name": "baseline",
        "argv": [
          "sh",
          "checks/baseline.sh"
        ],
        "timeout_ms": 60000
      }
    ]
  }
}
