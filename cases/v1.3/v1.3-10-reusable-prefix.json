{
  "id": "v1.3-10-reusable-prefix",
  "profile": "v1.3",
  "title": "Same-conversation provider-visible prefix and append-only input survive JSON serialization choices",
  "spec": [
    "\u00a74.9.2",
    "\u00a74.9.1"
  ],
  "fixture": "kt",
  "steps": [
    {
      "intent": "greet"
    },
    {
      "approve": "greet"
