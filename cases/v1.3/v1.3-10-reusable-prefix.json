      }
    },
    {
      "id": "verify",
      "expect": {
        "role": "builder"
      },
      "reply": {
        "calls": [
          {
            "name": "finish",
            "arguments": {}
          }
        ]
      }
    }
  ],
  "project": {
    "build": {
      "ladder": {
        "max_rungs": 1
      }
    }
  }
