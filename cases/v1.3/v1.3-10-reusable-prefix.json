            {
              "step": "inspect"
            },
            {
              "step": "verify"
            }
          ]
        },
        "fake_request_sequences": [
          {
            "select": [
              {
                "step": "edit"
              },
              {
                "step": "inspect"
              },
              {
                "step": "verify"
              }
            ],
            "same_cache_key": true,
            "same_thread_id": true,
            "session_header_matches_cache_key": true
          }
        ]
      }
    }
  ],
  "fake": true,
  "script": [
    {
      "id": "plan",
      "expect": {
        "role": "planner"
      },
      "reply": {
        "text": "Difficulty: easy\n\n## Technical approach\nChange lib/greet.txt and verify both approved items.\n"
      }
    },
    {
      "id": "edit",
      "expect": {
        "role": "builder"
      },
      "reply": {
        "calls": [
          {
            "name": "shell",
