{
  "id": "v1.3-11-cross-session-prefix",
  "profile": "v1.3",
  "title": "Two Shapes, two Builds and Shape-to-Build share static instructions/schemas with distinct threads",
  "spec": [
    "\u00a74.9.1",
    "\u00a74.9.2"
  ],
  "fixture": "kt",
  "steps": [
    {
      "snapshot": "initial"
    },
    {
      "write": {
        "path": "{case}/request1.md",
        "text": "Make the greeting in lib/greet.txt say Hello, World! instead of Hello!\n"
      }
    },
    {
      "run": [
        "kogen",
        "intent",
        "shape",
        "greet",
        "{case}/request1.md"
      ],
      "expect": {
        "exit": 0
      }
    },
    {
      "write": {
        "path": "{case}/request2.md",
        "text": "Make the greeting in lib/greet.txt say Hello, World! instead of Hello!\n"
      }
    },
    {
      "run": [
        "kogen",
        "intent",
        "shape",
        "other",
        "{case}/request2.md"
      ],
      "expect": {
        "exit": 0
      }
    },
    {
      "write": {
        "path": "lib/greet.txt",
        "text": "Hello!\n"
      }
    },
    {
      "commit": {
        "message": "Independent base 1",
        "push": true,
        "allow_empty": true
      }
    },
    {
      "approve": "greet"
    },
    {
      "run": [
        "kogen",
        "queue",
        "start"
      ],
      "expect": {
        "exit": 0
      }
    },
    {
      "git": [
        "fetch",
        "-q",
        "origin"
      ]
    },
    {
      "git": [
        "reset",
        "--hard",
        "origin/main"
      ]
    },
    {
      "write": {
        "path": "lib/greet.txt",
        "text": "Hello!\n"
      }
    },
    {
      "commit": {
        "message": "Independent base 2",
        "push": true,
        "allow_empty": true
      }
    },
    {
      "approve": "other"
    },
    {
      "run": [
        "kogen",
        "queue",
        "start"
      ],
      "expect": {
        "exit": 0
      }
